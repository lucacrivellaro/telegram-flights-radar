# --- Telegram (obbligatori) -------------------------------------------------
# Token del bot: crealo con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=
# ID della chat dell'ADMIN: riceve le richieste di iscrizione degli altri
# utenti e le approva con /approva. Scrivi al bot e leggi l'ID con
# https://api.telegram.org/bot<TOKEN>/getUpdates (campo message.chat.id)
TELEGRAM_CHAT_ID=

# --- Travelpayouts (consigliato: abilita scali e altre compagnie) -----------
# Token API: registrati gratis su travelpayouts.com → Profilo → API token
TRAVELPAYOUTS_TOKEN=
# Marker affiliato (opzionale, per i deep-link Aviasales)
TRAVELPAYOUTS_MARKER=

# --- Ricerca -----------------------------------------------------------------
# NB: aeroporti, soglie e liste qui sotto sono i DEFAULT per ogni nuovo
# utente; ciascuno può personalizzarli con /aeroporti, /soglia, /destinazioni
# Aeroporti per le mete europee/corto raggio
ORIGIN_AIRPORTS=VRN,BGY
# Aeroporti per il LUNGO RAGGIO: offerte extra-Europa e viaggi a tappe.
# Separati perché uno scalo regionale (VRN) non ha voli intercontinentali
INTL_ORIGIN_AIRPORTS=VCE,BGY,MXP
# Finestra di ricerca: da domani a N giorni avanti (vale per l'Europa)
SEARCH_DAYS_AHEAD=45
# Il LUNGO RAGGIO (extra-Europa A/R e viaggi a tappe) guarda più in là: stessa
# ampiezza di finestra, spostata in avanti di N giorni. 0 = come l'Europa.
# Misurato sui dati reali: a +60 le A/R dirette extra-Europa passano da 9 a 26
# e il prezzo minimo da 583€ a 313€; i viaggi a tappe invece calano da 18 a 12
# itinerari (la cache Travelpayouts è più densa sulle date vicine). 60 è il
# compromesso: bastano 2 offerte al giorno per fascia e ce ne sono in abbondanza
LONGHAUL_START_DAYS=60
# Whitelist destinazioni (codici IATA, vuota = tutte) es: LIS,BCN,OPO
DESTINATIONS_WHITELIST=
# Blacklist destinazioni es: TIA,CRL
DESTINATIONS_BLACKLIST=
# Durata soggiorno (in notti): le offerte inviate sono solo andata/ritorno
MIN_TRIP_NIGHTS=3
MAX_TRIP_NIGHTS=10

# --- Cosa conta come "offerta" ------------------------------------------------
# Soglie assolute sul prezzo TOTALE andata/ritorno (€). Ognuna vale solo per
# la sua fascia: alzare EXTRA_RT non tocca le mete europee
PRICE_THRESHOLD_EUROPE_RT=70
# Alta perché vale su voli intercontinentali DIRETTI: sotto i 550€ esistono
# solo tariffe con scalo, che qui non vengono proposte
PRICE_THRESHOLD_EXTRA_RT=900
# Sconto % minimo rispetto alla media storica della rotta
DISCOUNT_THRESHOLD_PCT=30
# Rilevazioni minime prima di fidarsi della media storica
MIN_HISTORY_SAMPLES=5
# Quante offerte al massimo nel messaggio giornaliero
TOP_N=8
# Di queste, quante riservate alle mete extra-Europa (le restanti vanno
# all'Europa: 8-2 = 6). Serve una quota perché lo score è prezzo/soglia della
# fascia e un A/R europeo batte sempre il lungo raggio. I posti che una fascia
# non riempie passano all'altra
TOP_N_EXTRA=2
# Solo voli diretti verso Europa/corto raggio (due scali tecnici per andare a
# Barcellona non sono un affare)
DIRECT_ONLY=true
# Lo stesso per il lungo raggio. Attivandolo il bot fa una ricerca dedicata
# (una chiamata per aeroporto e mese) perché le tariffe cached normali sul
# lungo raggio sono sempre con scalo: senza, i posti TOP_N_EXTRA resterebbero
# vuoti. Le dirette costano di più, da qui PRICE_THRESHOLD_EXTRA_RT alta
DIRECT_ONLY_EXTRA=true
# Non re-inviare la stessa offerta per N giorni (salvo cali di prezzo >10%)
RESEND_COOLDOWN_DAYS=3

# --- Viaggi a tappe (multitratta) ---------------------------------------------
# Itinerari composti: casa → più città con sosta di più notti → rientro.
# Partono dagli aeroporti INTL_ORIGIN_AIRPORTS. Ogni tratta è un biglietto di
# sola andata separato, il prezzo è la somma.
# Richiede TRAVELPAYOUTS_TOKEN (serve il prezzo giorno per giorno di ogni rotta).
MULTI_ENABLED=true
# Quanti itinerari aggiungere in fondo al messaggio (oltre alle TOP_N offerte)
MULTI_TOP_N=2
# Soglia sul TOTALE dell'itinerario (€), non sul singolo volo. Alta perché le
# tappe sono extra-Europa: itinerari reali visti a 360-550€
PRICE_THRESHOLD_MULTI=700
# Accetta come tappe solo destinazioni fuori dall'Europa/corto raggio
MULTI_EXTRA_EUROPE_ONLY=true
# Tappe OBBLIGATORIE di default (CSV IATA, vuota = nessun vincolo): ogni
# itinerario proposto dovrà passare da ALMENO UNA di queste città (OR, non
# AND: ogni città in più allarga le possibilità). Ogni utente ha la sua lista,
# gestita con /tappe. Vincolare il percorso riduce molto gli itinerari trovati
# e ne alza il prezzo: di solito va alzata anche PRICE_THRESHOLD_MULTI
MULTI_REQUIRED_STOPS=
# Numero di città intermedie (esclusi casa e rientro)
MULTI_MIN_STOPS=2
MULTI_MAX_STOPS=4
# Notti minime di sosta in ogni città intermedia. Non c'è un massimo per
# tappa: la durata di una sosta è limitata solo dai giorni totali del viaggio
MULTI_MIN_STAY_NIGHTS=2
# Durata dell'intero viaggio, dalla partenza al rientro (giorni). Il minimo
# evita assurdità come Milano→Bali→Singapore→Milano in 4 giorni, con ~48h di
# volo su 4 giorni di viaggio
MULTI_MIN_TRIP_DAYS=10
MULTI_MAX_TRIP_DAYS=20
# Accetta solo tratte dirette fra una tappa e l'altra. false di proposito:
# sulle rotte intercontinentali pretendere i diretti azzera la resa
# (da VCE: 0 itinerari con i diretti, 3 ammettendo gli scali)
MULTI_DIRECT_ONLY=false
# Ampiezza della ricerca: catene tenute in vita e destinazioni provate per
# tappa. Alzarli trova più itinerari ma costa più chiamate API e tempo
MULTI_BEAM_WIDTH=4
MULTI_CANDIDATES=6
# Tetto di chiamate API per aeroporto di partenza (~140 in un giro tipico):
# se viene raggiunto la ricerca si ferma e lo segnala nei log
MULTI_MAX_API_CALLS=250

# --- Scheduler -----------------------------------------------------------------
DAILY_TIME=08:00
TIMEZONE=Europe/Rome

# --- Persistenza -----------------------------------------------------------------
DB_PATH=data/flights.db
